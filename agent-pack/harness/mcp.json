{
  "mcpServers": {
    "mcp-lighthouse": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp/lighthouse/dist/index.js"],
      "env": {
        "JIRA_BASE_URL": "https://jira.nutanix.com",
        "JIRA_PAT": "${env:JIRA_PAT}",
        "HTTPS_PROXY": "${env:HTTPS_PROXY}",
        "NAI_API_BASE_URL": "${env:NAI_API_BASE_URL}",
        "NAI_API_KEY": "${env:NAI_API_KEY}",
        "NAI_DEFAULT_MODEL": "${env:NAI_DEFAULT_MODEL}",
        "NAI_MAX_TOKENS": "${env:NAI_MAX_TOKENS}",
        "NAI_REQUEST_TIMEOUT": "${env:NAI_REQUEST_TIMEOUT}"
      }
    },
    "mcp-loom": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp/loom/dist/index.js"],
      "env": {
        "JIRA_PAT": "${env:JIRA_PAT}",
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
      }
    }
  }
}
