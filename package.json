{
  "name": "ndb-delivery-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Consolidated NDB-Ops delivery tooling: web app, Streamlit TPM tools, and a custom MCP server. Workspace root.",
  "workspaces": [
    "apps/*",
    "apps/delivery-ops/server",
    "apps/delivery-ops/client",
    "mcp-server",
    "shared"
  ],
  "scripts": {
    "mcp:build": "npm --workspace mcp-server run build",
    "mcp:start": "npm --workspace mcp-server run start",
    "delivery-ops:dev": "npm --workspace apps/delivery-ops run dev",
    "delivery-ops:restart": "cd apps/delivery-ops && ./restart"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "proxy-addr": "2.0.8",
    "tar": "7.5.22",
    "follow-redirects": "1.16.2",
    "nth-check": "2.0.1",
    "node-forge": "1.4.3",
    "serialize-javascript": "7.1.4",
    "postcss": "8.5.32",
    "bfj": "9.1.3",
    "underscore": "1.13.8",
    "resolve-url-loader": "5.0.0",
    "jsonpath": "1.3.0",
    "body-parser@<2": "1.20.9",
    "body-parser@>=2": "2.4.0",
    "undici@<7": "6.29.1",
    "undici@>=7": "7.30.1",
    "nodemailer": "10.3.1",
    "qs": "6.17.1",
    "react-scripts": {
      "bfj": "9.1.3",
      "resolve-url-loader": "5.0.0",
      "postcss": "8.5.32",
      "underscore": "1.13.8",
      "jsonpath": "1.3.0"
    }
  }
}
