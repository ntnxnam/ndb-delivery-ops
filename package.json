{
  "name": "ndb-delivery-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Consolidated NDB-Ops delivery tooling: web app, Streamlit TPM tools, and a custom MCP server. Workspace root.",
  "workspaces": [
    "apps/*",
    "apps/delivery-ops/server",
    "apps/delivery-ops/client",
    "mcp-server",
    "shared"
  ],
  "scripts": {
    "mcp:build": "npm --workspace mcp-server run build",
    "mcp:start": "npm --workspace mcp-server run start",
    "delivery-ops:dev": "npm --workspace apps/delivery-ops run dev",
    "delivery-ops:restart": "cd apps/delivery-ops && ./restart"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "tar": "7.5.22",
    "node-gyp": {
      "undici": "6.29.0"
    }
  }
}
