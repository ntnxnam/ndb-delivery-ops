  "labels": {
    "porExclude": {
      "pattern": "{prefix}-not-por",
      "jql": "labels not in (\"{prefix}-not-por\")",
      "template": "labels not in (\"{label}\")",
      "description": "POR exclusion label \u2014 ticket is not part of Plan-of-Record scope; filtered out of commit counts. Empty-label tickets need (labels is EMPTY OR labels not in ...) wrapper at call site (releaseOutstandingDeferralService already does).",
      "usedIn": [
        "fetch",
        "commit-jql",
        "reports"
      ],
      "variants": [
        "{prefix}-non-por"
      ]
    },
    "lifecycle": {
      "deferred": {
        "pattern": "{prefix}-{version}-deferred",
        "jql": "labels = \"{prefix}-{version}-deferred\"",
        "template": "labels = \"{label}\"",
        "description": "Deferred from release \u2014 ticket moved out of fixVersion but retains label for audit",
        "usedIn": [
          "fetch",
          "release-outstanding-work",
          "retro"
        ]
      },
      "mustfix": {
        "pattern": "{prefix}-{version}-mustfix",
        "jql": "labels = \"{prefix}-{version}-mustfix\"",
        "template": "labels = \"{label}\"",
        "description": "Must-fix for release \u2014 must ship even if deferred; overrides deferred label for same version",
        "usedIn": [
          "fetch",
          "release-outstanding-work",
          "briefing"
        ]
      },
      "wishlist": {
        "pattern": "{prefix}-{version}-wishlist",
        "jql": "labels = \"{prefix}-{version}-wishlist\"",
        "template": "labels = \"{label}\"",
        "description": "Wishlist / candidate pool for release \u2014 not committed, used for dependency sidecar",
        "usedIn": [
          "fetch",
          "payload-sidecar",
          "dependency-view"
        ]
      },
      "longTermFunded": {
        "pattern": "{prefix}-{version}-long-term-funded",
        "jql": "labels = \"{prefix}-{version}-long-term-funded\"",
        "template": "labels = \"{label}\"",
        "description": "Long-term funded work \u2014 funded across multiple releases, shown alongside fixVersion scope",
        "usedIn": [
          "fetch",
          "gantt",
          "release-items"
        ]
      },
      "extension": {
        "pattern": "{prefix}-{version}-code-complete-extension-recieved",
        "jql": "labels in (\"{prefix}-{version}-code-complete-extension-recieved\", \"{prefix}-{version}-code-complete-extention-recieved\")",
        "template": "labels = \"{label}\"",
        "description": "Code-complete extension received \u2014 FEAT granted extra time beyond gate. Note: recieved/extention are JIRA-canonical misspellings preserved for back-compat (correct received variant intentionally in variants if present).",
        "usedIn": [
          "fetch",
          "release-items"
        ],
        "variants": [
          "{prefix}-{version}-code-complete-extention-recieved"
        ]
      }
    },
    "dependency": {
      "trainAsk": {
        "pattern": "{prefix}-{train}-dependency",
        "jql": "labels in (\"{prefix}-{train}-dependency\")",
        "template": "labels = \"{label}\"",
        "description": "Train dependency ask \u2014 partner team dependency requested for a release train",
        "usedIn": [
          "dependency-view",
          "fetch"
        ]
      }
    },
    "testType": {
      "systemTest": {
        "pattern": "longevity",
        "jql": "labels = longevity",
        "template": "labels = \"{label}\"",
        "description": "System-test / longevity marker \u2014 used to slice ST scale and KPI pulse",
        "usedIn": [
          "kpi",
          "system-test-scale"
        ],
        "variants": [
          "system-test",
          "system_test"
        ]
      }
    }
  },
