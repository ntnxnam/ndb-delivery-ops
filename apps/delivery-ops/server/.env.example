# SMTP Configuration for Secure eMail Relay
# Requires AD SMTP service account in OU=SMTP Service Accounts
# From address must be the service account for relay to accept mail (no sending on behalf of users).
# Reply-To is set to the requesting user so replies go to the right person.
SMTP_HOST=secure-mailrelay.corp.nutanix.com
SMTP_PORT=587
SMTP_USER=smtp.ndb.team@nutanix.com
SMTP_PASS=<set-in-local-env-never-commit>
# Optional: override From (default from emailConfig.smtp.from). Must be service account for relay.
# SMTP_FROM=smtp.ndb.team@nutanix.com

# Server Port
PORT=6001

# Release Versions page access (server-side API gate)
# 'all'       → any authenticated user can access Release Versions endpoints (default)
# 'allowlist' → only users in allowedUsers.json → allowedUsers
# 'none'      → no one (disabled)
RELEASE_VERSIONS_PAGE_ACCESS=all

# Release Versions email sending access (server-side API gate)
# 'allowlist' (default) → only releaseVersionsEmailSenders in allowedUsers.json
# 'all'                 → any authenticated user can send
# 'none'                → no one (disabled)
RELEASE_VERSIONS_EMAIL_ACCESS=allowlist

# Nutanix Enterprise AI API Configuration
# Non-secret values (endpoint, model, limits) are canonical in:
#   server/config/aiConfig.json
# Copy them here — these env vars take precedence over aiConfig.json.
# No defaults are applied in code; all four vars below are required.
AI_API_BASE_URL=https://nai-dre.corp.p10y.ntnxdpro.com/enterpriseai/gateway/v1
AI_DEFAULT_MODEL=nemotron3-fp4-uni
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT=30000
# API key — secret, NOT in aiConfig.json. Retrieve from LastPass.
AI_API_KEY=your_nutanix_ai_api_key_here

# Self-Learning Agent Feature Flags
# Enable/disable the entire self-learning system (default: false)
ENABLE_SELF_LEARNING_AGENT=false
# Enable continuous learning background processes (default: false)
ENABLE_CONTINUOUS_LEARNING=false
# Enable automatic model evolution (default: false)
ENABLE_MODEL_EVOLUTION=false
# Enable feedback collection (default: false)
ENABLE_FEEDBACK_COLLECTION=false
# Enable outcome tracking (default: false)  
ENABLE_OUTCOME_TRACKING=false
