# Test environment for refactored architecture
NODE_ENV=development
PORT=9876

# JIRA Configuration  
JIRA_BASE_URL=https://nutanix.atlassian.net
JIRA_API_V2=https://nutanix.atlassian.net/rest/api/2
JIRA_API_V3=https://nutanix.atlassian.net/rest/api/3

# Email Configuration (keep same as production)
SMTP_HOST=smtp.nutanix.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=ndb-status@nutanix.com

# Security
ALLOWED_ORIGINS=http://localhost:6100,http://127.0.0.1:6100
SESSION_SECRET=test-refactor-session-secret-key

# Features for testing
ENABLE_DEBUG_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
CACHE_TTL=300000

# Database (separate from production)
DB_PATH=./data/test-refactor.db

# Refactor-specific settings
REFACTOR_MODE=true
TEST_PORT=9876
CLIENT_PORT=6100